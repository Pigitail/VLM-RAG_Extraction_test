# Copy to .env (git-ignored) and fill in. The CLI loads ./.env if it exists;
# variables already set in the environment take precedence.

# Backend: openai | azure | compatible | null
VLMRAG_PROVIDER=openai
# Model name (on Azure: the deployment name)
VLMRAG_MODEL=gpt-6-luna

# --- provider: openai -------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
# Optional; also used by provider "compatible" (e.g. http://localhost:8000/v1 for vLLM)
OPENAI_BASE_URL=

# --- provider: azure --------------------------------------------------------
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# Set to use the classic AzureOpenAI client (e.g. 2025-04-01-preview);
# leave empty to use the version-less v1 endpoint <endpoint>/openai/v1/.
AZURE_OPENAI_API_VERSION=

# --- call infrastructure ----------------------------------------------------
VLMRAG_MAX_CONCURRENCY=4
VLMRAG_TIMEOUT_S=600
VLMRAG_MAX_RETRIES=3
# low | medium | high; empty disables the parameter for non-reasoning models
VLMRAG_REASONING_EFFORT=low
# 1 = request strict JSON-schema output; 0 for servers that reject response_format
VLMRAG_STRUCTURED_OUTPUT=1
# On-disk response cache (recommended while iterating)
VLMRAG_CACHE_DIR=.cache/vlm

# --- tools --------------------------------------------------------------------
# Path to the LibreOffice binary if it is not on PATH or in the default location
VLMRAG_SOFFICE=
# Directory for the per-call LibreOffice profiles (default: the system temp dir).
# Keep it short: a long profile path makes LibreOffice crash on Windows.
VLMRAG_LO_PROFILE_ROOT=

# --- optional retrieval summary -------------------------------------------------
# Comma-separated doc types (drawing, slides, docx) that get the retrieval-summary prefix
VLMRAG_RETRIEVAL_SUMMARY=
